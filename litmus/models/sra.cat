C SRA

(*
 * Strong Release-Acquire: the release-acquire fragment of C/C++11 strengthened
 * so that happens-before and modification order agree GLOBALLY rather than
 * locally.
 *
 *   Ori Lahav, Nick Giannarakis and Viktor Vafeiadis, "Taming Release-Acquire
 *   Consistency", POPL 2016.  doi:10.1145/2837614.2837643
 *   Axioms as tabulated in Lahav & Boker, TOPLAS 44(2), 2022, Table 1.
 *
 * written for this dataset (not vendored).  Identical to ra.cat except that
 * write-coherence (irreflexive mo;hb -- a local agreement) is replaced by
 * strong-write-coherence (acyclic hb|mo -- a global one).  Keep the two in step.
 *)

include "cos.cat"

let mo = co

let sw = [W & (REL | ACQ_REL | SC)]; rf; [R & (ACQ | ACQ_REL | SC)]
let hb = (po | sw)+

irreflexive hb                as irr-hb
acyclic hb | mo               as strong-write-coherence
irreflexive mo; hb; rf^-1     as read-coherence
irreflexive mo; mo; rf^-1     as atomicity

show hb, mo
